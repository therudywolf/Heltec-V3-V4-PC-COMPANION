/*
 * NOCTURNE_OS — WiFi & PC connection
 * Copy to include/secrets.h and set your values. Do not commit secrets.h.
 */
#ifndef NOCTURNE_SECRETS_H
#define NOCTURNE_SECRETS_H

#define WIFI_SSID "YourNetwork"
#define WIFI_PASS "YourPassword"

/* Optional: multiple WiFi networks with automatic failover. When defined, this
 * takes precedence over WIFI_SSID/WIFI_PASS above — the board connects to the
 * strongest reachable network in the list and re-connects across them if the
 * current one drops. Order is not priority (WiFiMulti picks by signal). */
// #define WIFI_NETWORKS { {"HomeAP", "pass1"}, {"PhoneHotspot", "pass2"} }

#define PC_IP     "192.168.1.2"
#define TCP_PORT  8888

/* Optional: static IP to avoid DHCP timeouts (V4 WiFi stability). Uncomment and set. */
// #define WIFI_STATIC_IP   "192.168.1.123"
// #define WIFI_GATEWAY     "192.168.1.1"
// #define WIFI_SUBNET      "255.255.255.0"

#endif
