/*
 * NOCTURNE_OS — WiFi & PC connection
 * Copy to include/secrets.h and set your values. Do not commit secrets.h.
 */
#ifndef NOCTURNE_SECRETS_H
#define NOCTURNE_SECRETS_H

#define WIFI_SSID "YourNetwork"
#define WIFI_PASS "YourPassword"

/* Optional: multiple WiFi networks with automatic failover. When defined, this
 * takes precedence over WIFI_SSID/WIFI_PASS above. ORDER IS PRIORITY: the board
 * connects to the FIRST (primary) network — put the one your PC server is on
 * first — and only cycles to the others as failover when it is unreachable. */
// #define WIFI_NETWORKS { {"HomeAP", "pass1"}, {"PhoneHotspot", "pass2"} }

/* PC monitoring server. Two transports:
 *   A) Raw TCP to a LAN IP (default) — only works on the PC's own network.
 *   B) TLS to a public domain on :443 (HTTPS-fronted proxy → the :8888 server).
 *      Works on any WiFi (incl. a phone hotspot). Define NOCT_SERVER_TLS and
 *      set PC_IP to the hostname (no port in the URL == 443).
 * PC_IP accepts either a numeric IP or a hostname (DNS-resolved). */
#define PC_IP     "192.168.1.2"
#define TCP_PORT  8888
// #define PC_IP    "monitor.example.com"   // (B) TLS domain
// #define TCP_PORT 443
// #define NOCT_SERVER_TLS                   // (B) enable TLS transport

/* Optional: static IP to avoid DHCP timeouts (V4 WiFi stability). Uncomment and set. */
// #define WIFI_STATIC_IP   "192.168.1.123"
// #define WIFI_GATEWAY     "192.168.1.1"
// #define WIFI_SUBNET      "255.255.255.0"

#endif
